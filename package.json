{
  "name": "math-pentathlon",
  "version": "1.0.0",
  "description": "Math Pentathlon - A math game app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "size:check": "node scripts/check-bundle-budgets.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:cross": "playwright test --project=firefox --project=webkit --project=ipad-webkit",
    "test:e2e:firefox-webkit": "playwright test --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-iphone-13 --project=mobile-pixel-7 --project=mobile-ipad",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "test:e2e:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "test:e2e:visual:update": "playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "perf:runtime": "node scripts/runtime-perf.mjs",
    "audit:memory": "node scripts/memory-leak-audit.mjs",
    "test": "npm run test:unit && npm run test:e2e:chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
